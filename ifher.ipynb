from collections import deque
def water_jug_problem(cap1,cap2,target):
    visited=set()
    queue= deque([((0,0)[])])
    while queue:
        (x,y),steps=queue.popleft()
        if x==target or y==target:
            steps.append((x,y))
        if x==target:
            steps.append((x,0))
        else:
            steps.append((0,y))
        return steps
    if(x,y) in visited:
        continue
    visited.add((x,y))
    next_states=[
        (cap1, y),
        (x,cap2),
        (0,y),
        (x,0),
        (x-min(x,cap2-y), y+min(x,cap2-y)),
        (x+min(y,cap1-x), y-min(y,cap-x))
    ]
    for state in next_states:
        if state not in visited:
            queue.append((state,steps+[(x,y)]))
return None
cap1=int(input("Enter the capacity of Jug 1: "))
cap2=int(input("Enter the capacity of Jug 2: "))
target=int(input("Enter the target amount of water: "))
result=water_jug_problem(cap1,cap2,target)
if result:
    print(f"\n steps to measure{target} liters: ")
    for step in result:
        print(f"({step[0]}, {step[1]})")
else:
    print("No solution found")

